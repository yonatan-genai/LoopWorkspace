# Targeted renewal of the Loop distribution certificate (fork addition).
#
# Upstream renews with `match nuke`, which revokes EVERY distribution certificate
# on the team and breaks other apps signed by the same account. These lanes touch
# only the certificate stored in Match-Secrets and the Loop profiles:
#
#   renew_loop_cert   when the Match-Secrets certificate is missing or expires within
#                     RENEW_DAYS, retire it from Match-Secrets and let match create a
#                     new certificate and new Loop profiles. The old certificate stays
#                     valid on Apple until revoke_loop_cert runs after a good build.
#   revoke_loop_cert  revoke one certificate by id, after guards.
#
# Both lanes take dry_run (option, or LOOP_CERT_DRY_RUN=true) and then only report.
# Results go to fastlane/loop_cert_result.txt as key=value lines for the workflow.

LOOP_RESULT_FILE = File.expand_path("loop_cert_result.txt")
DISTRIBUTION_TYPES = ["DISTRIBUTION", "IOS_DISTRIBUTION"]

def loop_app_identifiers
  [
    "com.#{TEAMID}.loopkit.Loop",
    "com.#{TEAMID}.loopkit.Loop.statuswidget",
    "com.#{TEAMID}.loopkit.Loop.LoopWatch.watchkitextension",
    "com.#{TEAMID}.loopkit.Loop.LoopWatch",
    "com.#{TEAMID}.loopkit.Loop.Loop-Intent-Extension",
    "com.#{TEAMID}.loopkit.Loop.LoopWidgetExtension"
  ]
end

def loop_match_auth
  Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}")
end

def loop_flag(options, key, env)
  value = options.key?(key) ? options[key] : ENV[env]
  value.to_s.downcase == "true"
end

# Clone Match-Secrets the way match does (basic auth header, never in the URL).
def clone_match_secrets
  dir = Dir.mktmpdir("match-secrets")
  url = "https://github.com/#{GITHUB_REPOSITORY_OWNER}/Match-Secrets.git"
  header = "AUTHORIZATION: basic #{loop_match_auth}"
  sh("git", "-c", "http.extraheader=#{header}", "clone", "--quiet", "--depth", "1",
     "--branch", "master", url, dir, log: false)
  dir
end

def stored_cert_ids(dir)
  Dir[File.join(dir, "certs", "distribution", "*.cer")].map { |path| File.basename(path, ".cer") }.sort
end

def write_loop_result(values)
  File.write(LOOP_RESULT_FILE, values.map { |k, v| "#{k}=#{v}" }.join("\n") + "\n")
  UI.message("Result (#{LOOP_RESULT_FILE}): #{values.map { |k, v| "#{k}=#{v}" }.join(' ')}")
end

# The renewal stage in progress, so a failure alert can say what failed.
def loop_stage(text)
  File.write(File.expand_path("loop_cert_stage.txt"), text + "\n")
end

def days_left(cert)
  ((Time.parse(cert.expiration_date) - Time.now) / 86_400).floor
end

# Every distribution certificate on the team with the profiles that use it.
def distribution_inventory
  certs = Spaceship::ConnectAPI::Certificate.all.select { |c| DISTRIBUTION_TYPES.include?(c.certificate_type) }
  profiles = Spaceship::ConnectAPI::Profile.all(includes: "bundleId,certificates")
  certs.map do |cert|
    users = profiles.select { |p| (p.certificates || []).any? { |c| c.id == cert.id } }
                    .map { |p| p.bundle_id ? p.bundle_id.identifier : p.name }
                    .uniq.sort
    { cert: cert, used_by: users }
  end
end

def print_inventory(inventory, stored_ids)
  UI.header("Distribution certificates on team #{TEAMID}")
  inventory.each do |entry|
    cert = entry[:cert]
    tag = stored_ids.include?(cert.id) ? " [Loop, in Match-Secrets]" : ""
    used = entry[:used_by].empty? ? "no profiles" : entry[:used_by].join(", ")
    UI.message("#{cert.id} #{cert.certificate_type} '#{cert.name}' expires #{cert.expiration_date} (#{days_left(cert)} days)#{tag}; used by: #{used}")
  end
end

platform :ios do
  desc "Report which Loop certificate is active and whether Loop can still be signed (for failure alerts)"
  lane :loop_cert_state do
    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )
    stored_ids = stored_cert_ids(clone_match_secrets)
    inventory = distribution_inventory
    profiles = Spaceship::ConnectAPI::Profile.all(includes: "bundleId,certificates")
    lines = ["Match-Secrets holds: #{stored_ids.empty? ? 'no certificate' : stored_ids.join(', ')}"]
    inventory.each do |entry|
      cert = entry[:cert]
      tag = stored_ids.include?(cert.id) ? " [in Match-Secrets]" : ""
      lines << "On Apple: #{cert.id} '#{cert.name}' expires #{cert.expiration_date[0, 10]} (#{days_left(cert)} days)#{tag}"
    end
    active = inventory.map { |e| e[:cert] }.find { |c| stored_ids.include?(c.id) && days_left(c) >= 0 }
    missing = loop_app_identifiers.reject do |identifier|
      profiles.any? do |p|
        p.profile_type == "IOS_APP_STORE" && p.profile_state == "ACTIVE" && p.bundle_id && p.bundle_id.identifier == identifier &&
          active && (p.certificates || []).any? { |c| c.id == active.id }
      end
    end
    lines << if active.nil?
               "Loop CANNOT build: no valid certificate in Match-Secrets."
             elsif missing.empty?
               "Loop can build: #{active.id} is valid and all #{loop_app_identifiers.count} Loop profiles use it."
             else
               "Loop CANNOT build yet: #{active.id} is valid but these profiles do not use it: #{missing.join(', ')}."
             end
    lines << "Installed Loop on the phone keeps working until its TestFlight build expires (90 days after upload)."
    File.write(File.expand_path("loop_cert_state.txt"), lines.join("\n") + "\n")
    lines.each { |line| UI.message(line) }
  end

  desc "Renew only the Loop distribution certificate when it is close to expiry (no nuke)"
  lane :renew_loop_cert do |options|
    setup_ci if ENV['CI']
    dry_run = loop_flag(options, :dry_run, "LOOP_CERT_DRY_RUN")
    renew_days = (options[:renew_days] || ENV["LOOP_CERT_RENEW_DAYS"] || 30).to_i
    max_certs = (options[:max_certs] || ENV["LOOP_CERT_MAX_DISTRIBUTION"] || 3).to_i

    loop_stage("reading the certificate inventory (App Store Connect API or Match-Secrets clone); nothing was changed")
    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )

    dir = clone_match_secrets
    stored_ids = stored_cert_ids(dir)
    inventory = distribution_inventory
    print_inventory(inventory, stored_ids)

    active = inventory.map { |e| e[:cert] }.select { |c| days_left(c) >= 0 }
    loop_cert = active.select { |c| stored_ids.include?(c.id) }.max_by { |c| Time.parse(c.expiration_date) }
    free_slots = max_certs - active.count
    UI.message("Match-Secrets holds: #{stored_ids.empty? ? 'nothing' : stored_ids.join(', ')}")
    UI.message("Active distribution certificates: #{active.count} of #{max_certs}, free slots: #{free_slots}")

    if loop_cert && days_left(loop_cert) > renew_days
      UI.success("Loop certificate #{loop_cert.id} is valid for #{days_left(loop_cert)} days (renews at #{renew_days}). Nothing to do.")
      write_loop_result(action: "none", old_cert_id: "", new_cert_id: "", dry_run: dry_run)
      next
    end

    reason = loop_cert ? "#{loop_cert.id} expires in #{days_left(loop_cert)} days" : "no valid Loop certificate in Match-Secrets"
    old_id = loop_cert ? loop_cert.id : ""

    if free_slots < 1
      loop_stage("no free distribution certificate slot (#{active.count} of #{max_certs} in use); nothing was created or revoked")
      write_loop_result(action: "no_slot", old_cert_id: old_id, new_cert_id: "", dry_run: dry_run)
      message = "Loop needs a new distribution certificate (#{reason}), but all #{max_certs} slots are in use. " \
                "Nothing was created or revoked. Free a slot by hand (revoke a certificate no app uses), then run again."
      dry_run ? UI.important("DRY RUN: would fail: #{message}") : UI.user_error!(message)
      next
    end

    if dry_run
      UI.important("DRY RUN: would retire #{old_id.empty? ? '(none)' : old_id} from Match-Secrets, create 1 new distribution certificate " \
                   "(#{free_slots - 1} slots left after), regenerate profiles for #{loop_app_identifiers.join(', ')}, " \
                   "and revoke #{old_id.empty? ? 'nothing' : old_id} after a successful build. Reason: #{reason}.")
      write_loop_result(action: "would_renew", old_cert_id: old_id, new_cert_id: "", dry_run: true)
      next
    end

    loop_stage("retiring #{stored_ids.join(', ')} from Match-Secrets (git rm, commit, push)")
    # Retire the old files from Match-Secrets so match creates a new certificate.
    # Git history keeps them; Apple keeps the certificate valid until revoke_loop_cert.
    stored_ids.each do |id|
      sh("git", "-C", dir, "rm", "--quiet", "certs/distribution/#{id}.cer", "certs/distribution/#{id}.p12")
    end
    unless stored_ids.empty?
      sh("git", "-C", dir, "-c", "user.name=fastlane", "-c", "user.email=fastlane@users.noreply.github.com",
         "commit", "--quiet", "-m", "Retire Loop distribution certificate #{stored_ids.join(', ')} for renewal")
      sh("git", "-C", dir, "-c", "http.extraheader=AUTHORIZATION: basic #{loop_match_auth}", "push", "--quiet", "origin", "master", log: false)
    end

    loop_stage("match creating the new certificate and regenerating the Loop profiles, after #{stored_ids.join(', ')} was removed from Match-Secrets")
    ENV["MATCH_READONLY"] = false.to_s
    match(
      type: "appstore",
      force: true,
      git_basic_authorization: loop_match_auth,
      app_identifier: loop_app_identifiers
    )

    loop_stage("checking that match stored the new certificate in Match-Secrets")
    new_ids = stored_cert_ids(clone_match_secrets)
    new_id = (new_ids - stored_ids).first
    UI.user_error!("match did not store a new certificate (Match-Secrets holds #{new_ids.join(', ')})") if new_id.nil?
    UI.success("New Loop certificate #{new_id}; #{old_id.empty? ? 'no old certificate to revoke' : "#{old_id} is revoked after a successful build"}.")
    write_loop_result(action: "renewed", old_cert_id: old_id, new_cert_id: new_id, dry_run: false)
  end

  desc "Revoke one old Loop distribution certificate by id, after a successful build with its replacement"
  lane :revoke_loop_cert do |options|
    dry_run = loop_flag(options, :dry_run, "LOOP_CERT_DRY_RUN")
    cert_id = (options[:cert_id] || ENV["LOOP_OLD_CERT_ID"]).to_s
    UI.user_error!("cert_id is required") if cert_id.empty?

    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )

    loop_stage("revoking old Loop certificate #{cert_id}: guard checks")
    stored_ids = stored_cert_ids(clone_match_secrets)
    UI.user_error!("#{cert_id} is still in Match-Secrets, refusing to revoke the certificate Loop builds with") if stored_ids.include?(cert_id)

    entry = distribution_inventory.find { |e| e[:cert].id == cert_id }
    if entry.nil?
      UI.important("#{cert_id} is not on the team any more, nothing to revoke")
      next
    end
    others = entry[:used_by].reject { |id| loop_app_identifiers.include?(id) }
    UI.user_error!("#{cert_id} is used by profiles outside Loop (#{others.join(', ')}), refusing to revoke") unless others.empty?

    if dry_run
      UI.important("DRY RUN: would revoke #{cert_id} '#{entry[:cert].name}' (expires #{entry[:cert].expiration_date})")
      next
    end
    loop_stage("revoking old Loop certificate #{cert_id}: Apple API call")
    entry[:cert].delete!
    UI.success("Revoked old Loop distribution certificate #{cert_id}")
  end
end
